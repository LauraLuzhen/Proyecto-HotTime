generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                  Int             @id @default(autoincrement())
  name                String          @db.VarChar(100)
  latitude            Float?
  longitude           Float?
  allowedRadiusMeters Int?
  categories          Category[]
  users               User[]
  communications      Communication[]
  shifts              Shift[]
  attendances         Attendance[]
}

model Category {
  id              Int              @id @default(autoincrement())
  name            String           @db.VarChar(100)
  organizationId  Int
  organization    Organization     @relation(fields: [organizationId], references: [id])
  userCategories  UserCategory[]
  shiftCategories ShiftCategory[]

  @@unique([name, organizationId])
  @@unique([id, organizationId])
}

model User {
  id             Int          @id @default(autoincrement())
  fullName       String       @db.VarChar(100)
  email          String       @unique @db.VarChar(150)
  password       String
  role           Role
  birthDate      DateTime
  initDate       DateTime
  phone          String       @db.VarChar(20)
  imgProfile     String?      @db.VarChar(255)
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  resetToken     String?      @unique @db.VarChar(255)
  resetTokenExp  DateTime?
  userCategories         UserCategory[]
  sentCommunications     Communication[]     @relation("SentCommunications")
  receivedCommunications CommunicationUser[]
  shifts                 Shift[]             @relation("UserShifts")
  createdShifts          Shift[]             @relation("CreatedShifts")
  attendances            Attendance[]

  @@unique([id, organizationId])
}

model UserCategory {
  userId     Int
  categoryId Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@index([categoryId])
}

model Communication {
  id             Int                 @id @default(autoincrement())
  title          String              @db.VarChar(150)
  content        String              @db.Text
  type           CommunicationType
  senderId       Int
  sender         User                @relation("SentCommunications", fields: [senderId], references: [id])
  organizationId Int
  organization   Organization        @relation(fields: [organizationId], references: [id])
  sentAt         DateTime            @default(now())
  recipients     CommunicationUser[]
}

model CommunicationUser {
  id              Int           @id @default(autoincrement())
  communicationId Int
  userId          Int
  communication   Communication @relation(fields: [communicationId], references: [id])
  user            User          @relation(fields: [userId], references: [id])
  read            Boolean       @default(false)
  createdAt       DateTime      @default(now())

  @@unique([communicationId, userId])
  @@index([userId])
}

model Shift {
  id             Int             @id @default(autoincrement())
  organizationId Int
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId         Int
  user           User            @relation("UserShifts", fields: [userId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdById    Int
  createdBy      User            @relation("CreatedShifts", fields: [createdById, organizationId], references: [id, organizationId], onDelete: Restrict)
  startsAt       DateTime
  endsAt         DateTime
  actualStartsAt DateTime?
  actualEndsAt   DateTime?
  status         ShiftStatus     @default(SCHEDULED)
  published      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  attendances    Attendance[]
  shiftCategories ShiftCategory[]

  @@unique([id, userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@index([startsAt])
  @@index([endsAt])
  @@index([published])
  @@index([status])
  @@index([organizationId, startsAt])
  @@index([organizationId, userId, startsAt])
}

model ShiftCategory {
  shiftId    Int
  categoryId Int
  shift      Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([shiftId, categoryId])
  @@index([categoryId])
}

model Attendance {
  id             Int            @id @default(autoincrement())
  organizationId Int
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shiftId        Int
  userId         Int
  shift          Shift          @relation(fields: [shiftId, userId, organizationId], references: [id, userId, organizationId], onDelete: Restrict)
  user           User           @relation(fields: [userId, organizationId], references: [id, organizationId], onDelete: Restrict)
  type           AttendanceType
  latitude       Float
  longitude      Float
  distanceMeters Float
  occurredAt     DateTime       @default(now())
  createdAt      DateTime       @default(now())

  @@unique([shiftId, type])
  @@index([organizationId])
  @@index([userId])
  @@index([shiftId])
  @@index([organizationId, occurredAt])
  @@index([organizationId, userId, occurredAt])
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum CommunicationType {
  INFO
  GENERAL
  WARNING
  URGENT
}

enum ShiftStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  MISSED
}

enum AttendanceType {
  CLOCK_IN
  CLOCK_OUT
}