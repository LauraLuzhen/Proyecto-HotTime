generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id              Int        @id @default(autoincrement())
  name            String     @db.VarChar(100)
  categories      Category[]
  users           User[]
  comunications   Communication[]
}

model Category {
  id             Int          @id @default(autoincrement())
  name           String       @db.VarChar(100)
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  userCategories UserCategory[]

  @@unique([name, organizationId])
}

model User {
  id                      Int                 @id @default(autoincrement())
  fullName                String              @db.VarChar(100)
  email                   String              @unique @db.VarChar(150)
  password                String
  role                    Role
  birthDate               DateTime
  initDate                DateTime
  phone                   String              @db.VarChar(20)
  imgProfile              String?             @db.VarChar(255)
  organizationId          Int
  resetToken              String?             @unique @db.VarChar(255)
  resetTokenExp           DateTime?
  organization            Organization        @relation(fields: [organizationId], references: [id])
  userCategories          UserCategory[]

  sentCommunications      Communication[]     @relation("SentCommunications") 
  receivedCommunications  CommunicationUser[]
}

model UserCategory {
  userId     Int
  categoryId Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@index([categoryId])
}

model Communication {
  id             Int                 @id @default(autoincrement())
  title          String              @db.VarChar(150)
  content        String              @db.Text
  type           CommunicationType   
  senderId       Int
  sender         User                @relation("SentCommunications", fields: [senderId], references: [id])
  organizationId Int
  organization   Organization        @relation(fields: [organizationId], references: [id])
  sentAt         DateTime            @default(now())
  recipients     CommunicationUser[]
}

model CommunicationUser {
  id              Int @id @default(autoincrement())
  communicationId Int
  userId          Int
  communication   Communication @relation(fields: [communicationId], references: [id])
  user            User          @relation(fields: [userId], references: [id])
  read            Boolean       @default(false)
  createdAt       DateTime      @default(now())

  @@unique([communicationId, userId])
  @@index([userId])
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum CommunicationType {
  INFO        
  GENERAL      
  WARNING    
  URGENT      
}
