{
  "compilerOptions": {
    "target": "ES2021",
    "module": "CommonJS",
    "moduleResolution": "node",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": false,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@hottime/types": ["../../packages/types/src/index.ts"]
    },
    "ignoreDeprecations": "6.0"
  },
  "exclude": [
    "node_modules",
    "prisma"
  ]
}